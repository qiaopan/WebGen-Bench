{
  "schema_version": 1,
  "memory_llm": {
    "deployment": "webgen-memory-gpt41-mini",
    "max_completion_tokens": 4096,
    "rate_limit_retries": 6,
    "rate_limit_base_seconds": 10,
    "rate_limit_max_wait_seconds": 300,
    "rate_limit_long_retry_seconds": 300,
    "rate_limit_long_retries": 0
  },
  "embedding": {"deployment": "webgen-memory-embedding", "dimensions": null},
  "runtime": {
    "complexity_routing_enabled": true,
    "simple_retrieval_strategy": "hard_soft",
    "medium_retrieval_strategy": "hard_soft",
    "complex_retrieval_strategy": "soft_only",
    "min_consolidation_evidence": 3,
    "min_activation_evidence": 1,
    "max_task_aspects": 3,
    "retrieval_candidates_per_type": 8,
    "case_retrieval_candidates_per_channel": 3,
    "case_retrieval_max_functional": 3,
    "case_retrieval_max_appearance": 1,
    "consolidation_candidates": 4,
    "retrieval_min_similarity": 0.35,
    "consolidation_min_similarity": 0.55,
    "top_k_experiences": 1,
    "top_k_skills": 1,
    "evidence_weight": 0.02,
    "evidence_cap": 5,
    "domain_match_weight": 0.08,
    "include_full_task_in_retrieval": false,
    "max_prompt_memory_chars": 3600,
    "max_prompt_workflow_steps": 4,
    "max_prompt_completion_checks": 4,
    "max_experiences_per_trajectory": 1,
    "max_skills_per_trajectory": 1,
    "max_grounding_trajectories": 5,
    "max_grounding_edges": 12,
    "max_evidence_items": 12,
    "max_evidence_chars": 12000,
    "max_outcome_chars": 2000,
    "schema_repair_retries": 2,
    "hierarchy_dedup_similarity": 0.9
  }
}

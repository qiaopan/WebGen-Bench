DASHSCOPE_API_KEY=replace-with-your-bailian-api-key
WEBVOYAGER_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
WEBVOYAGER_API_MODEL=qwen3-vl-32b-instruct
WEBVOYAGER_NUM_WORKERS=1

# Website generation through the Bolt OpenAI-like provider
WEBGEN_GENERATOR_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
WEBGEN_GENERATOR_API_MODEL=qwen3-coder-next

# Long-memory extraction/decomposition and vector retrieval
MEMORY_LLM_MODEL=webgen-memory-gpt41-mini
MEMORY_EMBEDDING_MODEL=webgen-memory-embedding
